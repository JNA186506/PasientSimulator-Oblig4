<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assessment.CasePage"
             x:Name="Root"
             BindingContext="{Binding }">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="CASE #" FontSize="24" FontAttributes="Bold" />
                    <Span Text="{Binding CaseId}" FontSize="24" FontAttributes="Bold" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <StackLayout Grid.Column="2" Grid.Row="0">
            <Label Text="Kommentarer:" FontSize="20" />
        </StackLayout>

        <!-- Comments list on the left side -->
        <CollectionView Grid.Column="3" Grid.Row="1" Grid.RowSpan="3"
                        ItemsSource="{Binding Comments, Source={x:Reference Root}}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="8" Margin="8" HasShadow="False" BackgroundColor="Grey">
                        <Label Text="{Binding .}" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Column="0" Grid.Row="1">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Patient: " FontSize="16" />
                    <Span Text="{Binding CasePatient.PatientName}" FontSize="16" FontAttributes="Bold" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <Label Grid.Column="1" Grid.Row="1">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Student: " FontSize="16" />
                    <Span Text="{Binding Student.Name}" FontSize="16" FontAttributes="Bold" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <Label Grid.Column="0" Grid.Row="2">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Status: " FontSize="16" />
                    <Span Text="{Binding CasePatient.Status}" FontSize="16" FontAttributes="Bold" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <Label Grid.Column="1" Grid.Row="2">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Temperatur: " FontSize="16" />
                    <Span Text="{Binding CasePatient.Temperature}" FontSize="16" FontAttributes="Bold" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <Label Grid.Column="0" Grid.Row="3">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Resperator status: " FontSize="16" />
                    <Span Text="{Binding CasePatient.RespiratoryRate}" FontSize="16" FontAttributes="Bold" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
        


        <Label Grid.ColumnSpan ="2" Grid.Row="2"/>
        <Editor 
            x:Name="vurdering"
            Grid.Column="0"
            Grid.ColumnSpan="1"
            Grid.Row="6"
            Placeholder="Skriv kommentar her..."
            TextColor="Black"
            />

        <Button Grid.Column="1" Grid.Row="6" Text="Legg til kommentar" Clicked="OnAddCommentClicked" />


    </Grid>
</ContentPage>