@page
@model CaseSetup.Pages.ChangeScenarioModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">ChangeScenario</h1>
    <h2>Existing case</h2>
    <ul>
        <li>Student: @Model.Case.Student.Name</li>
        <li>Patient: @Model.Case.CasePatient.PatientName</li>
        <li>
            <fieldset>
                <legend>Goals</legend>
                @foreach (var goal in Model.Case.Goals)
                {
                    @goal.Description
                }
            </fieldset>
        </li>
    </ul>
    <fieldset>
        <legend>Update case</legend>
        <form method="post">
            <input type="hidden" name="caseId" id="caseId" value="@Model.Case.CaseId" />
            <label for="selectStudent">Select student</label>
            <select name="selectStudent" id="selectStudent">
                @foreach (var student in Model.Students)
                {
                    <option value="@student.UserId" selected="@(student.UserId == Model.Case.Student.UserId)">@student.Name</option>
                }
            </select><br />
                <p>Goals</p>
                @foreach (var goal in Model.Goals)
                {
                    <label for="goal-@goal.GoalId">@goal.Description</label>
                    <input type="checkbox" id="goal-@goal.GoalId" name="goals" value="@goal.GoalId" @(Model.Case.Goals.Any(g => g.GoalId == goal.GoalId) ? "checked" : "") />
                }<br />
            <button type="submit" asp-page-handler="UpdateCase">Update Scenario</button>
        </form>
    </fieldset>
    <fieldset>
        <legend>Update patient</legend>
        <form method="post">
            <input type="hidden" name="caseId" id="patientCaseId" value="@Model.Case.CaseId" />
            <label for="selectStatus">Velg status</label>
            <select name="selectStatus" id="selectStatus">
                <option value="1" selected="@(Model.Case.CasePatient.Status == PasientSimulator.lib.Models.Patient.StatusEnum.Healthy)">Healthy</option>
                <option value="2" selected="@(Model.Case.CasePatient.Status == PasientSimulator.lib.Models.Patient.StatusEnum.Sick)">Sick</option>
                <option value="3" selected="@(Model.Case.CasePatient.Status == PasientSimulator.lib.Models.Patient.StatusEnum.Dead)">Dead</option>
            </select><br />
            <label for="patientName">Name</label>
            <input type="text" name="patientName" id="patientName" value="@Model.Case.CasePatient.PatientName"/><br />
            <label for="patientWeight">Weight</label>
            <input type="number" name="patientWeight" id="patientWeight" value="@Model.Case.CasePatient.Weight"/><br />
            <label for="patientAge">Age</label>
            <input type="number" name="patientAge" id="patientAge" value="@Model.Case.CasePatient.Age"/><br />
            <label for="selectSex">Sex</label>
            <select name="selectSex" id="selectSex">
                <option value="1" selected="@(Model.Case.CasePatient.Sex == PasientSimulator.lib.Models.Patient.SexEnum.Male)">Male</option>
                <option value="2" selected="@(Model.Case.CasePatient.Sex == PasientSimulator.lib.Models.Patient.SexEnum.Female)">Female</option>
                <option value="3" selected="@(Model.Case.CasePatient.Sex == PasientSimulator.lib.Models.Patient.SexEnum.Other)">Other</option>
            </select><br />
            <label for="heartrate">Heartrate</label>
            <input type="number" name="heartrate" id="heartrate" value="@Model.Case.CasePatient.Heartrate" /><br />
            <label for="bloodpressureSystolic">Bloodpressure Systolic</label>
            <input type="number" name="bloodpressureSystolic" id="bloodpressureSystolic" value="@Model.Case.CasePatient.BloodPressure.Systolic" /><br />
            <label for="bloodpressureDiastolic">Bloodpressure Diastolic</label>
            <input type="number" name="bloodpressureDiastolic" id="bloodpressureDiastolic" value="@Model.Case.CasePatient.BloodPressure.Diastolic" /><br />
            <label for="respiratoryRate">Respiratory Rate</label>
            <input type="number" name="respiratoryRate" id="respiratoryRate" value="@Model.Case.CasePatient.RespiratoryRate" /><br />
            <label for="oxygenSaturation">Oxygen Saturation</label>
            <input type="number" name="oxygenSaturation" id="oxygenSaturation" value="@Model.Case.CasePatient.OxygenSaturation" step="0.1" /><br />
            <label for="temperature">Temperature</label>
            <input type="number" name="temperature" id="temperature" value="@Model.Case.CasePatient.Temperature" step="0.1" /><br />
                <p>Diagnoses</p>
                @foreach (var illness in Model.Diagnoses)
                {
                    <label for="illness-@illness.IllnessId">@illness.IllnessName</label>
                    <input type="checkbox" id="illness-@illness.IllnessId" name="diagnoses" value="@illness.IllnessId" @(Model.Case.CasePatient.Diagnoses.Any(d => d.IllnessId == illness.IllnessId) ? "checked" : "") />
                }<br />
                <p>Allergies</p>
                @foreach (var allergy in Model.Allergies)
                {
                    <label for="allergy-@allergy.MedicationId">@allergy.MedicationName</label>
                    <input type="checkbox" id="allergy-@allergy.MedicationId" name="allergies" value="@allergy.MedicationId" @(Model.Case.CasePatient.Allergies.Any(a => a.MedicationId == allergy.MedicationId) ? "checked" : "") />
                }<br />
            <button type="submit" asp-page-handler="UpdatePatient">Update Patient</button>
        </form>
    </fieldset>
</div>